# Copy to .env and fill in ONE of the two auth options. Leave the other one out entirely
# (an empty ANTHROPIC_API_KEY= still counts as "set" and can shadow the token).
#
# Option A — personal Anthropic API key (console.anthropic.com):
# ANTHROPIC_API_KEY=sk-ant-...
#
# Option B — an API gateway that speaks the Anthropic API:
# ANTHROPIC_BASE_URL=https://your-gateway.example
# ANTHROPIC_AUTH_TOKEN=...
#
# Run `python run.py doctor` after changing auth — it checks both the API and WebSearch.

# Model overrides (defaults shown). Scouts are cheap and parallel; editor/checker benefit from the stronger model.
SCOUT_MODEL=claude-sonnet-5
RESEARCHER_MODEL=claude-sonnet-5
EDITOR_MODEL=claude-sonnet-5
CHECKER_MODEL=claude-sonnet-5

# Safety caps
SCOUT_MAX_TURNS=40
EDITOR_MAX_TURNS=80
CHECKER_MAX_TURNS=40
FACTCHECK_MAX_RETRIES=2
CHECKER_CONCURRENCY=4

# Hard USD ceilings per agent session (the SDK stops the session when reached)
SCOUT_MAX_BUDGET_USD=3
EDITOR_MAX_BUDGET_USD=15
CHECKER_MAX_BUDGET_USD=3

# ---------------------------------------------------------------------------
# X (Twitter) trending signal — OPTIONAL, off by default.
# Off: the pipeline runs its original 4 web-based scout beats, no X cost at all.
# On : adds a 5th "x-trends" scout with real spike data (trend lists + post
#      engagement), and lets the ranker use it as the trend_velocity evidence.
# Per-run override without editing this file: `run.py weekly --x` / `--no-x`.
# ---------------------------------------------------------------------------
X_TRENDS_ENABLED=false

# App-only Bearer token from the X Developer Console (Keys and tokens).
# The app must be attached to a Project or v2 calls return 403. No OAuth/refresh needed.
X_BEARER_TOKEN=

# Locations to sweep for trends. 1 = Worldwide (documented).
# 23424848 = India (legacy WOEID, not in X's published table — if X 404s it, drop it and keep 1).
X_TRENDS_WOEIDS=1,23424848

# Spend guards, enforced in code before each call. X bills trends per request ($0.010) and
# search PER POST RETURNED ($0.005 each), so the dollar cap is the one that actually matters.
X_MAX_API_CALLS=12
X_MAX_SPEND_USD=0.50
X_SEARCH_MAX_RESULTS=25
